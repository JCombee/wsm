# Generated by wsm-helper. Do not edit.
[Unit]
Description=wsm shared mariadb 11.8

[Container]
ContainerName=wsm-mariadb-11-8
Image=docker.io/library/mariadb:11.8
PublishPort=10.255.0.1:20000:3306
Secret=wsm-mariadb-11-8-root,type=env,target=MARIADB_ROOT_PASSWORD
Environment=MARIADB_AUTO_UPGRADE=1
Volume=wsm-mariadb-11-8-data:/var/lib/mysql
PodmanArgs=--memory=1g --pids-limit=512

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=900

[Install]
