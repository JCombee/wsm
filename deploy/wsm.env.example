# Settings for "wsm serve", read by wsm.service. Restart wsm after a change:
#   systemctl restart wsm
#
# The dashboard and the preview proxy listen on loopback only; a TLS proxy
# such as Caddy (see Caddyfile.example) puts them on the internet. Passkeys
# work only over HTTPS.
#
#   --dashboard-host   host name of the dashboard, e.g. dash.example.com
#   --dashboard-addr   loopback address of the dashboard (default 127.0.0.1:8080)
#   --preview-domain   previews live at <sandbox>--<project>.<domain>; use a
#                      separate registrable domain if you can (ADR 0017)
#   --preview-addr     loopback address of the preview proxy (default 127.0.0.1:8081)
#
# Without --dashboard-host there is no dashboard, only the CLI.
WSM_SERVE_FLAGS=
#WSM_SERVE_FLAGS=--dashboard-host dash.example.com --preview-domain example-preview.net
